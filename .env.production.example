# Copy to .env.production on the VM. Never commit the populated file.
APP_DOMAIN=rag.example.com
API_DOMAIN=api-rag.example.com
NEXT_PUBLIC_RAG_API_URL=https://api-rag.example.com

FIREBASE_PROJECT_ID=gyaan-sarthi
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=gyaan-sarthi.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=gyaan-sarthi
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=replace-with-firebase-storage-bucket
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace-with-firebase-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=replace-with-firebase-app-id

# Set backend credentials and model settings here, or inject them from Secret Manager.
GEMINI_API_KEY=replace-with-secret
SHARED_CORPUS_OWNER_ID=__shared_corpus__
LEGACY_ADMIN_UID=
SESSION_COOKIE_NAME=sarthi_session
SESSION_COOKIE_SAMESITE=lax
RAG_ALLOWED_ORIGINS=https://rag.example.com
INDEX_FOLDER_ROOTS=/app/data
