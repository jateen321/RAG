# ── LLM backend selection ────────────────────────────────────────────
# Which backend to route Gemini calls through:
#   developer → Gemini Developer API (free tier)      → uses GEMINI_API_KEY
#   vertex    → Agent Platform / Vertex express mode  → uses VERTEX_API_KEY
LLM_BACKEND=developer

# Gemini Developer API key (free tier). Starts with "AIza".
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_developer_api_key_here

# Agent Platform / Vertex express-mode API key. Starts with "AQ.".
# Only needed when LLM_BACKEND=vertex.
# Create one in Google Cloud console under Agent Platform → API Keys.
VERTEX_API_KEY=your_agent_platform_api_key_here

# Vertex-only embedding quota rotation. It is ignored when
# LLM_BACKEND=developer. Regions are ordered by measured latency from the
# development machine; a retryable failure falls through to the next.
EMBEDDING_REGION_ROTATION_ENABLED=1
VERTEX_EMBEDDING_PROJECT_ID=cloudexplore-502215
VERTEX_EMBEDDING_REGIONS=asia-south1,asia-southeast1,asia-east1,asia-northeast1,us-west1,us-central1,us-east4,europe-west4,europe-west1
VERTEX_EMBEDDING_TIMEOUT_S=20

# ── Retrieval pipeline ───────────────────────────────────────────────
# Keep the original question and generate up to nine Gemini rewrites. Their
# embeddings are batched, results are deduplicated, then combined with RRF.
QUERY_REWRITE_ENABLED=1
QUERY_REWRITE_MAX_QUERIES=10
QUERY_RETRIEVAL_TOP_K=5

# Rerank the RRF shortlist with Gemini; disable to use deterministic RRF order.
RERANK_ENABLED=1
RERANK_CANDIDATE_LIMIT=15
RERANK_MODEL=gemini-3.5-flash-lite

# Optional educational visuals generated from the user query and retrieved
# evidence when Image mode is enabled.
IMAGE_MODEL=gemini-3.1-flash-image

# Gemini selects this variable range of answer-worthy passages for normal questions.
# Explicit evaluation --top-k values remain fixed for comparable measurements.
MIN_CONTEXT_CHUNKS=5
MAX_CONTEXT_CHUNKS=15
NEAR_DUPLICATE_OVERLAP=0.85

# ── OCR backend: pick one of three ───────────────────────────────────
#   google_vision  Hosted dense-document OCR via Application Default
#                  Credentials (`gcloud auth application-default login`).
#                  RECOMMENDED. Best accuracy for the cost; 0 failed pages
#                  out of 90 measured. ~$1.50 per 1000 pages, first 1000
#                  pages each month free.
#   tesseract      Fully local, $0, works offline. Needs the `tesseract`
#                  binary + language data. Lower Devanagari accuracy
#                  (3.97% CER vs 0.00% on a measured verse) and it crashed
#                  on 3 of 90 pages, silently yielding an empty page.
#   gemini         Multimodal LLM (uses LLM_BACKEND + its API key). Accuracy
#                  on par with google_vision at ~1.3x the cost, and it is the
#                  only backend that reads hyphenation and block order
#                  correctly. BUT it silently drops regions it cannot read
#                  instead of marking them, so damage becomes invisible.
OCR_BACKEND=google_vision

# 0 selects the backend-specific default: Vision 8, Gemini 2, Tesseract up to 4.
OCR_MAX_WORKERS=0

# Soft priors for google_vision. They do not constrain output: adding 'sa'
# measurably changed nothing on a Hindi page.
GOOGLE_VISION_LANGUAGE_HINTS=hi,sa,en

# ── Distributed API admission control ───────────────────────────────
# Keep this off for local development. Public deployments must enable it and
# supply a TLS Redis URL from the managed provider (normally rediss://...).
RAG_RATE_LIMIT_ENABLED=0
REDIS_URL=rediss://default:password@managed-redis.example.com:6379/0

# Per-authenticated-user sustained rates and short bursts. A combined Web +
# Image request charges the ask, web, and image buckets atomically.
RAG_RATE_LIMIT_ASK_PER_MINUTE=10
RAG_RATE_LIMIT_ASK_BURST=3
RAG_RATE_LIMIT_WEB_PER_MINUTE=5
RAG_RATE_LIMIT_WEB_BURST=2
RAG_RATE_LIMIT_IMAGE_PER_MINUTE=2
RAG_RATE_LIMIT_IMAGE_BURST=1
RAG_RATE_LIMIT_INGEST_PER_HOUR=5
RAG_RATE_LIMIT_INGEST_BURST=5

# Shared across every API worker and replica through renewable Redis leases.
RAG_CONCURRENCY_INTERACTIVE=4
RAG_CONCURRENCY_WEB=2
RAG_CONCURRENCY_IMAGE=1
RAG_CONCURRENCY_INGEST=1

# Comma-separated browser origins allowed to call the FastAPI server.
RAG_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Firebase Google authentication ──────────────────────────────────
# Use the Firebase/Google Cloud project that owns the web app. Production
# normally obtains Admin credentials from the hosting service's identity.
FIREBASE_PROJECT_ID=your-project-id
# Stable internal owner for the corpus readable by guests and signed-in users.
SHARED_CORPUS_OWNER_ID=__shared_corpus__
# Firebase UID that receives conversation rows created before per-user tenancy.
LEGACY_ADMIN_UID=your-admin-firebase-uid
SESSION_COOKIE_NAME=sarthi_session
SESSION_COOKIE_MAX_AGE_S=432000
SESSION_COOKIE_SECURE=1
# Use lax when frontend and API are same-site. Use none only for unavoidable
# cross-site hosting; browsers then require Secure and may block the cookie.
SESSION_COOKIE_SAMESITE=lax
AUTH_RECENT_SIGN_IN_MAX_AGE_S=300
AUTH_CHECK_REVOKED=0

# Server-local roots that POST /index/folder may read. Separate multiple roots
# with ':' on macOS/Linux or ';' on Windows.
INDEX_FOLDER_ROOTS=./data
